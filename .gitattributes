# Normalize line endings: repository objects are LF, and working trees check
# out LF on every platform. The Node test suite slices source and workflow
# files with \n-anchored regexes, so a CRLF checkout (core.autocrlf=true on
# Windows) fails 8 tests that are green in CI. Pinning eol=lf makes local
# Windows checkouts behave exactly like the Linux CI runners.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.exe binary
*.zip binary
*.crx binary
*.xpi binary
*.pem binary
*.mhtml -text

# Exact bytes for authoritative documentation recovery and the owned helper.
/master/docstore.py -text
/docs/knowledge-export.jsonl -text
/docs/knowledge-export.sha256.json -text
/docs/knowledge-export-history/*.jsonl -text
/docs/knowledge-export-history/*.sha256.json -text
/docs/topics/*-export.jsonl -text
/docs/topics/*-export.sha256.json -text
/docs/topics/*-export-history/* -text
