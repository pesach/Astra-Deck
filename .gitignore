# Environment files may contain credentials; other owned files are trackable.
!*
.env
.env.*
*.env
*.env.*
.envrc
.envrc.*
.dev.vars
.dev.vars.*
# Private local agent context retained pending supported consumer relocation.
/.nmsa/index.sqlite
/.nmsa/index.sqlite-*

# Repository-owned authoritative documentation: version exports, not live DB/locks.
/docs/knowledge.sqlite
/docs/knowledge.sqlite-*
/docs/knowledge.sqlite.writer-lock/
/docs/.*.pending
/docs/knowledge-export-history/.*.pending
!/master/docstore.py
!/docs/knowledge-export.jsonl
!/docs/knowledge-export.sha256.json
!/docs/knowledge-export-history/
!/docs/knowledge-export-history/*.jsonl
!/docs/knowledge-export-history/*.sha256.json
/docs/.docstore-commit/
/docs/docstore-commit-config.json
/docs/topics/*.sqlite
/docs/topics/*.sqlite.writer-lock/
/docs/topics/*.sqlite-*
/docs/topics/*.lock/
